---
interface Props {
    script: string;
    alwaysShowRestart?: boolean;
    // For a long story: the height of the source and of the story beside it, each of which
    // scrolls, e.g. "36rem". Without it, both are as tall as their text.
    height?: string;
}

import Split from "./Split.astro";
import "squiffy-runtime/squiffy.runtime.css";

const { script, alwaysShowRestart, height } = Astro.props;

const buttonsClass = "sample-buttons" + (!alwaysShowRestart ? " hidden" : "");
---

<style is:global>
    /* Override runtime CSS link colors with theme colors */
    a.squiffy-link
    {
        text-decoration-color: var(--sl-color-text-accent) !important;
        color: var(--sl-color-text-accent) !important;
    }
    .viewer-container {
        padding: 0.5em;
    }
    .viewer p {
        margin-bottom: 1rem;
    }
    /* Icon buttons, like the Back and Restart buttons in a published story's header
       (button.squiffy-header-button in the runtime's CSS), in Starlight's colours */
    .sample-buttons {
        display: flex;
        gap: 0.25rem;
    }
    .sample-buttons.hidden {
        display: none;
    }
    .sample-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--sl-color-gray-3);
        cursor: pointer;
        background: none;
        border: none;
        border-radius: 0.375rem;
        padding: 0.375rem;
        transition: color 0.2s ease-in-out, background-color 0.2s ease-in-out, opacity 0.2s ease-in-out;
    }
    .sample-button:hover:not(:disabled) {
        color: var(--sl-color-white);
        background-color: color-mix(in srgb, currentColor 10%, transparent);
    }
    .sample-button:disabled {
        opacity: 0.4;
        cursor: default;
    }
    .sample-button:focus-visible {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: 2px;
    }
    .sample-button svg {
        width: 1.25rem;
        height: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .sample .editor {
        position: relative;
    }
    /* A sample with a height: the source and the story each scroll. Never taller than most of
       the window, so that on a phone, where they're one above the other, each fits. */
    .sample.fixed-height .editor .cm-editor {
        height: min(var(--sample-height), 75vh);
    }
    .sample.fixed-height .viewer-container {
        display: flex;
        flex-direction: column;
        height: min(var(--sample-height), 75vh);
        box-sizing: border-box;
    }
    .sample.fixed-height .viewer {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }
    /* Like the copy button on the docs' static code blocks (Expressive Code's), shown on hover
       where there's a mouse, and always on touch screens */
    .sample .copy {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    /* Keep the text clear of the copy button. The lines wrap, so it's every line, not just the first. */
    .sample .editor .cm-line {
        padding-right: 2.25rem;
    }
    @media (scripting: none) {
        .sample .copy {
            display: none;
        }
    }
    @media (scripting: enabled) {
        .sample .sample-source {
            display: none;
        }
    }
    .sample .sample-source {
        margin: 0;
        padding: 0.5rem;
        font-size: 13px;
        white-space: pre-wrap;
    }
    .sample .copy button {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        margin: 0;
        color: var(--sl-color-gray-2);
        background: var(--sl-color-gray-6);
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 0.2rem;
        cursor: pointer;
        opacity: 0.75;
        transition: opacity 0.2s ease, background 0.2s ease;
    }
    .sample .copy button svg {
        width: 1rem;
        height: 1rem;
    }
    .sample .copy button:hover,
    .sample .copy button:focus-visible {
        opacity: 1;
        background: var(--sl-color-gray-5);
    }
    @media (hover: hover) {
        .sample .copy button {
            opacity: 0;
            width: 2rem;
            height: 2rem;
        }
        .sample .editor:hover .copy button:not(:hover),
        .sample .editor:focus-within .copy button:not(:hover),
        .sample .copy .feedback.show ~ button:not(:hover) {
            opacity: 0.75;
        }
    }
    .sample .copy .feedback {
        padding: 0.125rem 0.75rem;
        border-radius: 0.2rem;
        font-size: 0.8rem;
        color: white;
        background: #0a5c3a;
        pointer-events: none;
        user-select: none;
        opacity: 0;
        transform: translateY(0.25rem);
        transition: opacity 0.2s ease-in-out, transform 0.2s ease-in-out;
    }
    .sample .copy .feedback.show {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<squiffy-sample
    class:list={["sample", "not-content", { "fixed-height": height }]}
    style={height ? `--sample-height: ${height}` : undefined}
    data-always-show-restart={alwaysShowRestart}>
    <Split gap="0.75rem" min="200px">
        <div slot="left" class="editor">
            <!-- The script, which the editor replaces. Without JavaScript it's shown as it is, and it's
                 how the sample's code reaches llms.txt (starlight-llms-txt converts this HTML to Markdown). -->
            <pre class="sample-source"><code class="language-squiffy">{script}</code></pre>
            <div class="copy">
                <div class="feedback" aria-live="polite"></div>
                <button type="button" title="Copy to clipboard" aria-label="Copy to clipboard">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path d="M3 19a2 2 0 0 1-1-2V2a2 2 0 0 1 1-1h13a2 2 0 0 1 2 1"/>
                        <rect x="6" y="5" width="16" height="18" rx="1.5" ry="1.5"/>
                    </svg>
                </button>
            </div>
        </div>
        <div slot="right" class="viewer-container">
            <div class="viewer"></div>
            <div class={buttonsClass}>
                <button type="button" class="sample-button back" title="Back" aria-label="Back" disabled>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                </button>
                <button type="button" class="sample-button restart" title="Restart" aria-label="Restart">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </button>
            </div>
        </div>
    </Split>
</squiffy-sample>

<script>
    import {basicSetup, EditorView} from 'codemirror';
    import { HighlightStyle, syntaxHighlighting } from '@codemirror/language';
    import { tags as t } from '@lezer/highlight';
    import { squiffyLanguage } from '@textadventures/squiffy-codemirror';
    import { compile as squiffyCompile } from 'squiffy-compiler';
    import {init as runtimeInit} from 'squiffy-runtime';
    import type { SquiffyApi } from 'squiffy-runtime';
    import debounce from 'debounce';

    // The same highlighting as the editor (app/src/lib/codemirror-theme.ts), in Starlight's colors,
    // whose -high shades are the readable ones in both light and dark mode
    const squiffyHighlightStyle = HighlightStyle.define([
        { tag: t.keyword, color: 'var(--sl-color-accent-high)', fontWeight: 'bold' },
        { tag: t.comment, color: 'var(--sl-color-gray-3)', fontStyle: 'italic' },
        { tag: t.tagName, color: 'var(--sl-color-accent-high)' },
        { tag: t.heading, color: 'var(--sl-color-accent-high)', fontWeight: 'bold' },
        { tag: t.heading2, color: 'var(--sl-color-purple-high)', fontWeight: 'bold' },
        { tag: t.link, color: 'var(--sl-color-accent-high)', textDecoration: 'underline' },
        { tag: t.processingInstruction, color: 'var(--sl-color-orange-high)' },
        { tag: t.monospace, color: 'var(--sl-color-gray-3)' },
    ]);

    class Sample extends HTMLElement {
        connectedCallback() {
            const editor = this.querySelector('.editor') as HTMLElement;
            if (!editor) return;

            const source = editor.querySelector('.sample-source');
            const initialScript = source?.textContent ?? '';
            source?.remove();

            const viewer = this.querySelector('.viewer') as HTMLElement;
            if (!viewer) return;

            let squiffyApi: SquiffyApi | null;
            let script = '';
            let loaded = false;

            const restart = this.querySelector('.restart') as HTMLButtonElement;
            const back = this.querySelector('.back') as HTMLButtonElement;

            const init = async () => {
                await initRuntime(script, viewer, restart, back);
            };

            const updateListener = EditorView.updateListener.of(async (update) => {
                const value = update.state.doc.toString();
                if (value == script) return;

                script = value;

                if (!loaded) {
                    loaded = true;
                    await init();
                } else {
                    debounce(init, 1000)();
                }
            });

            const editorView = new EditorView({
                doc: initialScript,
                extensions: [
                    basicSetup,
                    squiffyLanguage,
                    syntaxHighlighting(squiffyHighlightStyle),
                    EditorView.lineWrapping,
                    EditorView.theme({
                        ".cm-content": {fontSize: "13px"},
                        ".cm-lineNumbers": {fontSize: "13px"},
                        // basicSetup's own colours are light-only, so use Starlight's, which follow
                        // the site's light/dark switch
                        ".cm-gutters": {
                            backgroundColor: "var(--sl-color-gray-6)",
                            color: "var(--sl-color-gray-3)",
                            borderRight: "1px solid var(--sl-color-hairline)",
                        },
                        ".cm-activeLine": {
                            backgroundColor: "color-mix(in srgb, var(--sl-color-accent) 12%, transparent)",
                        },
                        ".cm-activeLineGutter": {
                            backgroundColor: "color-mix(in srgb, var(--sl-color-accent) 20%, transparent)",
                            color: "var(--sl-color-white)",
                        },
                        "&.cm-focused .cm-selectionBackground, .cm-selectionBackground, .cm-content ::selection": {
                            backgroundColor: "color-mix(in srgb, var(--sl-color-accent) 30%, transparent)",
                        },
                        ".cm-cursor": {borderLeftColor: "var(--sl-color-white)"},
                    }),
                    updateListener
                ],
                parent: editor
            });

            // Copies the script as it is now, with any changes the reader has made
            const copyButton = this.querySelector('.copy button') as HTMLButtonElement;
            const copyFeedback = this.querySelector('.copy .feedback') as HTMLElement;
            let hideFeedback: ReturnType<typeof setTimeout> | undefined;
            copyButton.addEventListener('click', async () => {
                const text = editorView.state.doc.toString();
                try {
                    await navigator.clipboard.writeText(text);
                } catch {
                    // As Expressive Code's copy button does, fall back to the old way where the
                    // Clipboard API isn't allowed
                    const textarea = document.createElement('textarea');
                    textarea.value = text;
                    textarea.style.position = 'fixed';
                    textarea.style.opacity = '0';
                    document.body.appendChild(textarea);
                    textarea.select();
                    const copied = document.execCommand('copy');
                    textarea.remove();
                    copyButton.focus();
                    if (!copied) return;
                }
                copyFeedback.textContent = 'Copied!';
                copyFeedback.classList.add('show');
                clearTimeout(hideFeedback);
                hideFeedback = setTimeout(() => {
                    copyFeedback.classList.remove('show');
                    copyFeedback.textContent = '';
                }, 1500);
            });

            const alwaysShowRestart = this.dataset.alwaysShowRestart === 'true';
            const fixedHeight = this.classList.contains('fixed-height');

            async function initRuntime(script: string, outputContainer: HTMLElement, restartButton: HTMLElement, backButton: HTMLElement) {
                const result = await squiffyCompile({
                    script: script,
                    // As in a story with a squiffy.json, which every story made in the editor has:
                    // @set and link setters take expressions (#373)
                    expressions: true,
                });

                if (!result.success) {
                    console.error("Failed to compile script", result.errors);
                    return;
                }

                const data = result.output;
                const js = data.js.map(jsLines => new Function('squiffy', 'get', 'set', jsLines.join('\n')));

                if (squiffyApi)
                {
                    const story = {
                        js: js as any,
                        ...result.output.story,
                    };
                    squiffyApi.update(story);
                }
                else {
                    outputContainer.innerHTML = '';
                    const output = document.createElement('div');
                    outputContainer.appendChild(output);

                    squiffyApi = await runtimeInit({
                        element: output,
                        scroll: 'none',
                        persist: false,
                        story: {
                            js: js as any,
                            ...data.story,
                        }
                    });

                    await squiffyApi.begin();

                    // With a height, the story scrolls in its own box (not with the runtime's
                    // scroll: 'element', whose scrollIntoView would scroll the page too): after a
                    // click, to where the new text starts, or to the top if the screen was cleared
                    if (fixedHeight) {
                        // What was there before the click: how tall it was, and its last section,
                        // which a cleared screen moves into a hidden stack, for Back. (linkClick
                        // comes too late, as it's after the new text.)
                        let before = 0;
                        let lastSection: Element | null = null;
                        const remember = () => {
                            before = outputContainer.scrollHeight;
                            lastSection = [...outputContainer.querySelectorAll('.squiffy-output-section')].pop() ?? null;
                        };
                        outputContainer.addEventListener('click', remember, { capture: true });
                        outputContainer.addEventListener('keydown', remember, { capture: true });
                        squiffyApi.on('navigated', () => requestAnimationFrame(() => {
                            const cleared = !!lastSection?.closest('.squiffy-clear-stack');
                            outputContainer.scrollTo({ top: cleared ? 0 : Math.max(0, before - 16), behavior: 'smooth' });
                        }));
                    }

                    // The buttons appear once a link is clicked (or straight away, with alwaysShowRestart)
                    const buttons = restartButton.parentElement!;
                    const showButtonsOnLinkClick = () => {
                        squiffyApi?.once('linkClick', () => {
                            buttons.classList.remove('hidden');
                        });
                    };

                    showButtonsOnLinkClick();

                    // As in a published story, Back is disabled when there's nowhere to go back to,
                    // rather than hidden, so Restart doesn't move
                    const updateBack = () => {
                        (backButton as HTMLButtonElement).disabled = !squiffyApi?.canGoBack();
                    };
                    squiffyApi.on('canGoBackChanged', updateBack);

                    backButton.addEventListener('click', () => {
                        squiffyApi?.goBack();
                        updateBack();
                    });

                    restartButton.addEventListener('click', () => {
                        squiffyApi?.restart();
                        if (!alwaysShowRestart) {
                            buttons.classList.add('hidden');
                        }
                        showButtonsOnLinkClick();
                        updateBack();
                    });
                }
            }
        }
    }
    customElements.define('squiffy-sample', Sample);
</script>