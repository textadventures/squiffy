# Every page: the editor is never in another site's frame, where it could be made to delete a
# story by a click on something else that's drawn over it (#644). Its own preview frame is a
# srcdoc one, which these don't affect.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_app/immutable/*
  cache-control: max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json

# Checked for a new version on every load
/service-worker.js
  cache-control: no-cache
