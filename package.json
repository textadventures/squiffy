{
  "name": "squiffy",
  "version": "7.0.0-beta.21",
  "private": true,
  "type": "module",
  "workspaces": [
    "compiler",
    "codemirror-lang",
    "project-fs",
    "graph-map",
    "editor-search",
    "player",
    "app",
    "cli",
    "packager",
    "runtime",
    "site",
    "types",
    "vite-plugin",
    "vscode",
    "examples/vite-app"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "publish:manual": "lerna publish from-package --no-private",
    "lint": "eslint .",
    "screenshots": "playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "eslint": "^10.2.1",
    "lerna": "^10.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.51.0"
  },
  "overrides": {
    "nx": {
      "undici": "^7.30.1"
    }
  }
}
