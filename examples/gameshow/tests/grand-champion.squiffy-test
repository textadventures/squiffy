# A playthrough of the story, recorded with --play --record.
# Run it with --test, or record it again with --test --update.
seed 4
input player_name=priya
input final_answer=hank spinneroni

went "before the show"
set score = 0
set round = 0
set patience = 3
set prizes = []
set rounds_tonight = 3
set wheel = ["General Knowledge","Beat the Clock","Professor Boom's Lab","The Mystery Box","The Audience Decides"]
set tonight = ["The Mystery Box","Professor Boom's Lab","General Knowledge"]

> Take your seat
went "intro"

> Press Enter in the text box for player_name
went "contestant"
set player_name = "Priya"

> let's spin...

> Spin the wheel!
went "spin"
set round = 1
set tonight = ["Professor Boom's Lab","General Knowledge"]
set spins = 16
set landed = "The Mystery Box"

> Let's play!
went "The Mystery Box"
set box = "goat"

> Shake the box first
went "Shake the box first"
set patience = 2

> Open the box
went "open the box"
set score = 150
set prizes = ["a goat (on loan)"]

> Next round!
went "next round"

> Cut to the adverts
went "commercial break"

> Back to the show!
went "_continue1"

> Spin the wheel!
went "spin"
set round = 2
set tonight = ["General Knowledge"]
set landed = "Professor Boom's Lab"

> Let's play!
went "Professor Boom's Lab"
set lab = {"stability":100,"mixture":[]}
set shelf = [{"name":"Fizz","look":"fizzing blue"},{"name":"Sulk","look":"sulky green"},{"name":"Gloop","look":"suspiciously beige"},{"name":"Shriek","look":"screaming orange"}]

> Add the fizzing blue one
went "Professor Boom's Lab" "add"
set lab = {"stability":70,"mixture":["Fizz"]}
set chemical = "Fizz"

> Add the sulky green one
went "Professor Boom's Lab" "add"
set lab = {"stability":40,"mixture":["Fizz","Sulk"]}
set chemical = "Sulk"

> Present your compound
went "compound"
set score = 300
set prizes = ["a goat (on loan)","a flask of Fizzosulkium"]
set element = "Fizzosulkium"

> Next round!
went "next round"

> Spin the wheel!
went "spin"
set round = 3
set tonight = []
set landed = "General Knowledge"

> Let's play!
went "General Knowledge"
set gk_answer = "Paris"

> Lock in your answer
went "General Knowledge" "lock in"
set score = 400

> Next round!
went "next round"

> On to the final question
went "final question"

> That's my final answer
went "final answer"
set final_answer = "hank spinneroni"

> It is
went "the verdict"
set score = 800

> See how you did
went "Ending"
set counted = 800
set step = 53
