{
  "name": "squiffy-compiler",
  "version": "6.0.1",
  "description": "A tool for creating multiple-choice interactive stories",
  "author": "Alex Warren",
  "contributors": [
    "CrisisSDK",
    "mrangel",
    "Luis Felipe Morales"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textadventures/squiffy.git",
    "directory": "compiler"
  },
  "license": "MIT",
  "preferGlobal": true,
  "devDependencies": {
    "@types/node": "^26.6.6",
    "glob": "^14.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "test": "vitest --run",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run test"
  },
  "main": "dist/compiler.js",
  "types": "dist/compiler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./language-service": {
      "types": "./dist/language-service.d.ts",
      "default": "./dist/language-service.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "type": "module"
}
