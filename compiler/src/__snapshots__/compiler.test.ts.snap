exports[`textprocessor/textprocessor.squiffy 1`] = `
"export const story = {};
story.id = "00000000-0000-0000-0000-000000000000";
story.uiJsIndex = 0;
story.start = "_default";
story.sections = {
    "_default": {
        "text": "It's another {{random (array \\"Monday\\" \\"Tuesday\\" \\"Wednesday\\" \\"Thursday\\" \\"Friday\\" \\"Saturday\\" \\"Sunday\\")}} in the city.\\n\\nThe weather is {{random (array \\"sunny\\" \\"cloudy\\" \\"rainy\\" \\"windy\\" \\"snowy\\") set=\\"weather\\"}}.\\n\\nChoose a gender:\\n\\n* {{section \\"start\\" text=\\"Male\\" set=\\" gender=male\\"}}\\n* {{section \\"start\\" text=\\"Female\\" set=\\" gender=female\\"}}\\n"
    },
    "start": {
        "text": "You chose {{gender}}.\\n\\n{{#if gender = \\"male\\"}}\\nYou are a man.\\n{{else}}\\nYou are a woman.\\n{{/if}}\\n\\nIt's still {{weather}}.\\n\\n{{passage \\"Next\\"}}\\n",
        "passages": {
            "Next": {
                "text": "This is a test. {{embed \\"passage\\"}} {{embed \\"section\\"}}\\n\\nHere's a video, embedded using a custom helper defined in the \`@ui\` block at the top of this file:\\n\\n{{youtube \\"dQw4w9WgXcQ\\" width=480 height=270}}\\n\\n{{section \\"tutor\\" text=\\"Visit the tutor\\"}}\\n"
            },
            "passage": {
                "text": "Text from passage.\\n"
            }
        }
    },
    "section": {
        "text": "Text from section.\\n"
    },
    "tutor": {
        "text": "The \`visit\` helper shows different text each time you come here:\\n\\n{{visit \\"tutorvisits\\" \\"“And you are?…”\\" \\"“Ahh, here you are…”\\" \\"“You again!”\\"}}\\n\\n{{section \\"tutor\\" text=\\"Visit the tutor again\\"}}"
    }
};
story.js = [
	(squiffy, get, set) => {
		squiffy.registerHelper("youtube", (id, options) => {
		    const width = options.hash.width || 560;
		    const height = options.hash.height || 315;
		    return new squiffy.SafeString(
		        \`<iframe width="\${width}" height="\${height}" src="https://www.youtube-nocookie.com/embed/\${encodeURIComponent(id)}" \` +
		        \`title="YouTube video" frameborder="0" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>\`);
		});
		// Shows a different piece of text each time it's displayed, then keeps showing the last one.
		// The first argument is the attribute used to count how many times it has been shown.
		squiffy.registerHelper("visit", (attribute, ...args) => {
		    const items = args.slice(0, -1);
		    const count = squiffy.get(attribute) || 0;
		    squiffy.set(attribute, count + 1);
		    return items[Math.min(count, items.length - 1)];
		});
	},
];"
`;

exports[`transitions/transitions.squiffy 1`] = `
"export const story = {};
story.id = "00000000-0000-0000-0000-000000000000";
story.start = "_default";
story.sections = {
    "_default": {
        "text": "You are standing in a room. You can see a {{passage \\"hammer\\"}}.\\n",
        "passages": {
            "hammer": {
                "text": "It's nice and weighty. Perhaps you want to {{section \\"hit\\" text=\\"hit yourself in the face with it\\"}}?\\n"
            }
        }
    },
    "hit": {
        "text": "Bang.\\n",
        "jsIndex": 0
    },
    "wake up": {
        "clear": true,
        "text": "Slowly your eyes open.\\n\\nThat was a rather stupid thing to do."
    }
};
story.js = [
	(squiffy, get, set) => {
		squiffy.ui.transition(function(){
		    return new Promise((resolve) => {
		        // Create a blackout <div>...
		        const blackout = document.createElement("div");
		        blackout.id = "blackout";
		        Object.assign(blackout.style, {
		            position: "fixed",
		            top: "0",
		            left: "0",
		            width: "100%",
		            height: "100%",
		            background: "black",
		            opacity: "0",              // start transparent
		            transition: "opacity 6s ease-in" // fade duration + easing
		        });
		        squiffy.element.appendChild(blackout);
		        // Force style recalculation before starting the fade
		        requestAnimationFrame(() => {
		            blackout.style.opacity = "1"; // fade in over 6s
		        });
		        // After fading it in...
		        setTimeout(() => {
		            // Move to the next section...
		            squiffy.story.go("wake up");
		            // Fade out the blackout
		            blackout.style.transition = "opacity 6s ease-in";
		            blackout.style.opacity = "0";
		            // Remove <div> after transition ends
		            blackout.addEventListener("transitionend", () => {
		                blackout.remove();
		                resolve();
		            }, { once: true });
		        }, 9000);
		    });
		});
	},
];"
`;

