exports[`gameshow/gameshow.squiffy 1`] = `
"export const story = {};
story.id = "00000000-0000-0000-0000-000000000000";
story.expressions = true;
story.start = "intro";
story.sections = {
    "": {
        "clear": true,
        "text": "{{#if not (at \\"intro\\")}}\\n**SCORE: {{live \\"score\\"}}** | **ROUND: {{live \\"round\\"}}** | Host Patience: {{live \\"patience\\" section=\\"patience display\\"}}\\n{{/if}}\\n"
    },
    "patience display": {
        "text": "{{#if patience >= 3}}_Cheerful_{{else if patience >= 1}}_Strained_{{else}}_Murderous_{{/if}}\\n"
    },
    "intro": {
        "text": "{{set \\"availableRounds\\" (array \\"GENERAL KNOWLEDGE\\" \\"SCIENCE with PROFESSOR BOOM\\" \\"MYSTERY BOX\\" \\"THE AUDIENCE DECIDES\\")}}\\n\\n**{{#animate \\"typewriter\\" interval=200}}WELCOME TO...{{/animate}}**\\n\\n{{#animate \\"toast\\" interval=200}}THE WHEEL OF _DUBIOUS_ FORTUNE!{{/animate}}\\n\\n{{#animate \\"fadeIn\\" duration=2000}}\\nThe studio lights flicker ominously. A man in a sequined jacket stumbles onto the stage, holding cue cards upside down.\\n\\n\\"Hello and welcome! I'm your host, Chuck Wheelsworth!\\" He squints at the cards. \\"No wait, that's not right. I'm Hank Spinneroni. Definitely Hank.\\"\\n\\nThe audience—three people and a cardboard cutout—applauds uncertainly.\\n\\n\\"And YOU are our lucky contestant! What's your name?\\"\\n\\n<input type=\\"text\\" data-attribute=\\"player_name\\" placeholder=\\"Enter your name...\\" required minlength=\\"2\\" maxlength=\\"30\\">\\n\\n{{section \\"_continue1\\" text=\\"Let's play!\\"}}\\n{{/animate}}\\n",
        "attributes": [
            "score = 0",
            "round = 0",
            "patience = 3"
        ]
    },
    "_continue1": {
        "text": "\\"Welcome, {{player_name}}! Or as I like to call you... {{player_name}}!\\"\\n\\nHank pauses, waiting for laughter. None comes.\\n\\n{{embed \\"catchphrase\\"}}\\n\\n\\"Now then! {{#animate \\"continue\\" style=\\"wave\\"}}Let's spin...{{/animate}}\\"\\n\\n{{#animate \\"typewriter\\"}}THE WHEEL OF DUBIOUS FORTUNE!{{/animate}}\\n\\n{{#animate \\"fadeIn\\"}}\\nA rusty wheel descends from the ceiling, wobbling dangerously. It has several questionable categories painted on it.\\n\\n{{section \\"Spin the wheel!\\" text=\\"Spin the wheel!\\"}}\\n{{/animate}}\\n",
        "attributes": [
            "round = 1"
        ],
        "passages": {
            "catchphrase": {
                "text": "\\"Remember our motto: _'Whose Fortune Is It Anyway? (Legally Speaking, Ours)'_\\"\\n"
            }
        }
    },
    "Spin the wheel!": {
        "text": "The wheel creaks to life, spinning with a sound like a shopping cart hitting a pothole.\\n\\n{{set \\"category\\" (random availableRounds)}}\\n{{remove \\"availableRounds\\" category}}\\n\\nIt lands on... {{#animate \\"toast\\"}}{{category}}!{{/animate}}\\n\\n{{live \\"category\\" section=\\"showCategory\\"}}\\n"
    },
    "showCategory": {
        "text": "{{#if category = \\"GENERAL KNOWLEDGE\\"}}{{section \\"General Knowledge Round\\"}}{{/if}}\\n{{#if category = \\"SCIENCE with PROFESSOR BOOM\\"}}{{section \\"Science Round\\"}}{{/if}}\\n{{#if category = \\"MYSTERY BOX\\"}}{{section \\"Mystery Box Round\\"}}{{/if}}\\n{{#if category = \\"THE AUDIENCE DECIDES\\"}}{{section \\"Audience Round\\"}}{{/if}}\\n"
    },
    "General Knowledge Round": {
        "text": "\\"Ah, General Knowledge! The knowledge of generals! Or... general... people.\\" Hank shuffles his cards.\\n\\n\\"Here's your question, {{player_name}}:\\"\\n\\n**What is the capital of France?**\\n\\nYour answer: {{#label \\"answer\\"}}{{rotate (array \\"Paris\\" \\"London\\" \\"A baguette\\" \\"France doesn't exist\\") set=\\"gk_answer\\"}}{{/label}}\\n\\nStatus: {{#label \\"status\\"}}Waiting for answer...{{/label}}\\n\\n{{passage \\"Lock in answer\\"}}\\n",
        "passages": {
            "Lock in answer": {
                "text": "{{#replace \\"answer\\"}}**{{gk_answer}}**{{/replace}}\\n{{#replace \\"status\\"}}**LOCKED IN!**{{/replace}}\\n\\n{{#if gk_answer = \\"Paris\\"}}\\n{{#animate \\"toast\\"}}CORRECT!{{/animate}}\\n\\n{{#animate \\"fadeIn\\"}}\\n\\"That's right! Paris! City of lights, city of love, city of... bread?\\" Hank looks confused but happy.\\n{{/animate}}\\n\\n{{inc \\"score\\" 100}}\\n{{else}}\\n{{#if gk_answer = \\"A baguette\\"}}\\n{{dec \\"patience\\"}}\\n\\"A baguette? A BAGUETTE?!\\" Hank's eye twitches. \\"That's not even a city, {{player_name}}!\\"\\n\\nThe audience cardboard cutout falls over.\\n{{else}}\\n{{#if gk_answer = \\"France doesn't exist\\"}}\\n{{dec \\"patience\\"}}{{dec \\"patience\\"}}\\nHank stares at you for a very long time.\\n\\n\\"Security, please note that {{player_name}} is a 'flight risk.'\\"\\n{{else}}\\n\\"London? LONDON?!\\" Hank throws his cue cards in the air. \\"That's in... that's in a whole other country!\\"\\n{{dec \\"patience\\"}}\\n{{/if}}\\n{{/if}}\\n{{/if}}\\n\\n{{section \\"Next Round\\"}}\\n"
            }
        }
    },
    "Science Round": {
        "text": "The lights flicker and a trapdoor opens in the floor. Smoke billows out.\\n\\n{{#animate \\"typewriter\\"}}PROFESSOR BOOM has entered the chat.{{/animate}}\\n\\nA wild-haired scientist emerges, goggles askew, lab coat singed.\\n\\n\\"GREETINGS, QUIZ PARTICIPANT! I am Professor Boom, and THIS—\\" he holds up a beaker of bubbling green liquid \\"—is SCIENCE!\\"\\n\\nHank backs away nervously. \\"Professor, we talked about bringing chemicals on set...\\"\\n\\n\\"SILENCE, TELEVISION MAN! The contestant must answer... {{#animate \\"toast\\"}}A SCIENCE QUESTION!{{/animate}}\\"\\n\\n**What is the chemical symbol for Gold?**\\n\\nLab Stability: {{live \\"stability\\"}}%\\n\\nChoose your answer:\\n- {{section \\"Answer: Au\\"}}\\n- {{passage \\"Answer: Go\\"}}\\n- {{passage \\"Answer: Gd\\"}}\\n- {{passage \\"Drink the beaker\\"}}\\n",
        "attributes": [
            "stability = 100"
        ],
        "passages": {
            "@1": {
                "text": "{{dec \\"stability\\" 10}}\\nThe beaker bubbles more aggressively.\\n"
            },
            "@2": {
                "text": "{{dec \\"stability\\" 15}}\\nProfessor Boom: \\"HURRY! The compound is becoming... UNSTABLE!\\"\\n"
            },
            "@3": {
                "text": "{{dec \\"stability\\" 25}}\\n{{#animate \\"toast\\"}}WARNING: CRITICAL INSTABILITY{{/animate}}\\n\\nSmall explosions begin occurring around the lab set.\\n"
            },
            "Answer: Go": {
                "text": "\\"GO?! That's not even— that's just the word GO!\\" Professor Boom's hair somehow becomes more wild.\\n\\n{{dec \\"stability\\" 30}}\\n{{dec \\"patience\\"}}\\n\\n{{#if stability <= 30}}\\n{{#animate \\"toast\\"}}BOOM!{{/animate}}\\n\\nA small explosion singes Hank's eyebrows.\\n\\n\\"MY EYEBROWS! Those were RENTED!\\"\\n{{/if}}\\n"
            },
            "Answer: Gd": {
                "text": "\\"Gd is GADOLINIUM! An honest mistake for a FOOL!\\"\\n\\n{{dec \\"stability\\" 20}}\\n{{dec \\"patience\\"}}\\n"
            },
            "Drink the beaker": {
                "text": "You grab the beaker and drink it before anyone can stop you.\\n\\nProfessor Boom: \\"WAIT! That's my lunch!\\"\\n\\n{{#animate \\"toast\\"}}It tastes like... chicken soup?{{/animate}}\\n\\n\\"I was heating up my soup with SCIENCE. Now I have no lunch AND no science demonstration.\\"\\n\\n{{inc \\"score\\" 50}}\\nThe audience (including the cardboard) applauds your boldness.\\n"
            }
        }
    },
    "Answer: Au": {
        "text": "{{#animate \\"toast\\"}}CORRECT!{{/animate}}\\n\\n\\"AU! YES! Gold! Aurum! The element of CHAMPIONS!\\" Professor Boom throws the beaker in the air and catches it. \\"You have pleased me, {{player_name}}!\\"\\n\\n{{inc \\"score\\" 200}}\\n\\n{{section \\"_continue2\\" text=\\"Continue...\\"}}"
    },
    "_continue2": {
        "text": "Professor Boom descends back through the trapdoor, cackling.\\n\\n\\"UNTIL NEXT TIME, QUIZ PARTICIPANT! REMEMBER: SCIENCE IS JUST EXPLOSIONS IN A LAB COAT!\\"\\n\\nThe trapdoor slams shut. Hank pats out a small fire on his jacket.\\n\\n\\"Right. Well. That happened.\\"\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Mystery Box Round": {
        "text": "A golden box descends from the ceiling on a frayed rope.\\n\\n\\"Ooh, the Mystery Box!\\" Hank claps his hands. \\"This could contain ANYTHING! A prize! A question! A live animal! We genuinely don't know—the intern who loaded it quit this morning!\\"\\n\\nThe box rattles ominously.\\n\\n- {{section \\"Open the box carefully\\"}}\\n- {{section \\"Shake the box first\\"}}\\n- {{section \\"Refuse to open it\\"}}\\n"
    },
    "Open the box carefully": {
        "text": "You lift the lid slowly...\\n\\n{{set \\"box_contents\\" (random (array \\"prize\\" \\"bees\\" \\"another_box\\" \\"philosophy\\"))}}\\n\\n{{#if box_contents = \\"prize\\"}}\\n{{#animate \\"toast\\"}}JACKPOT!{{/animate}}\\n\\nInside is a solid gold trophy shaped like a wheel! It's spray-painted gold, but still!\\n\\n{{inc \\"score\\" 300}}\\n\\n\\"Congratulations! You've won our grand prize: a trophy AND the satisfaction of not being attacked by whatever else could have been in there!\\"\\n{{/if}}\\n\\n{{#if box_contents = \\"bees\\"}}\\n{{#animate \\"toast\\"}}BEES!{{/animate}}\\n\\nThe box is full of bees. They seem confused but not aggressive.\\n\\n\\"Oh no, NOT AGAIN!\\" Hank runs in circles. \\"WHO KEEPS PUTTING BEES IN THE MYSTERY BOX?!\\"\\n\\n{{dec \\"patience\\"}}\\n\\nA bee lands on your nose, considers its life choices, and flies away. You feel oddly respected.\\n\\n{{inc \\"score\\" 50}}\\n{{/if}}\\n\\n{{#if box_contents = \\"another_box\\"}}\\nInside the box is... another, smaller box.\\n\\n\\"Ah, the recursive box!\\" Hank nods sagely. \\"Open it!\\"\\n\\nInside THAT box is a note that says: \\"{{player_name}} wins 100 points!\\"\\n\\n{{inc \\"score\\" 100}}\\n\\n{{#animate \\"toast\\"}}Congratulations, somehow!{{/animate}}\\n{{/if}}\\n\\n{{#if box_contents = \\"philosophy\\"}}\\nInside is a small scroll. It reads:\\n\\n_\\"What IS a prize, really? Is not the true prize the friends we made along the way? Also here's 75 points.\\"_\\n\\n{{inc \\"score\\" 75}}\\n\\nHank wipes away a single tear. \\"Beautiful.\\"\\n{{/if}}\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Shake the box first": {
        "text": "You shake the box vigorously. Something inside goes \\"CLANG\\" and then \\"moo?\\"\\n\\n{{dec \\"patience\\"}}\\n\\n\\"Please don't shake the— you know what, fine. Open it.\\"\\n\\n{{section \\"Open the box carefully\\"}}\\n"
    },
    "Refuse to open it": {
        "text": "{{dec \\"patience\\"}}{{dec \\"patience\\"}}\\n\\n\\"You HAVE to open it! It's the MYSTERY BOX! The mystery is legally required to be resolved!\\"\\n\\nHank is sweating now.\\n\\n{{section \\"Open the box carefully\\"}}\\n"
    },
    "Audience Round": {
        "text": "\\"THE AUDIENCE DECIDES!\\" Hank gestures grandly at the three people and cardboard cutout.\\n\\n\\"Audience members, what challenge should {{player_name}} face?\\"\\n\\nThe audience confers. One of them is asleep. The cardboard cutout offers no input.\\n\\nFinally, a woman in the front row shouts: \\"MAKE THEM {{random (array \\"SING\\" \\"DANCE\\" \\"DO AN IMPRESSION OF A BLENDER\\" \\"JUST GIVE THEM POINTS FOR FREE\\") set=\\"make_them\\"}}!\\"\\n\\n{{#if make_them = \\"SING\\"}}\\n\\"You heard her! SING, {{player_name}}! Sing like your points depend on it! Because they do!\\"\\n\\n- {{section \\"Sing beautifully\\"}}\\n- {{section \\"Sing terribly on purpose\\"}}\\n{{/if}}\\n\\n{{#if make_them = \\"DANCE\\"}}\\n\\"DANCE! Show us your moves!\\"\\n\\n- {{section \\"Dance with enthusiasm\\"}}\\n- {{section \\"Do the robot\\"}}\\n{{/if}}\\n\\n{{#if make_them = \\"DO AN IMPRESSION OF A BLENDER\\"}}\\n\\"A BLENDER! Do a blender impression! This is normal television!\\"\\n\\n- {{section \\"WHIRRRRRR\\"}}\\n- {{section \\"Refuse on grounds of dignity\\"}}\\n{{/if}}\\n\\n{{#if make_them = \\"JUST GIVE THEM POINTS FOR FREE\\"}}\\n\\"Free points?! That's not how—\\" Hank checks his cards. \\"Actually, that IS an option apparently.\\"\\n\\n{{inc \\"score\\" 150}}\\n{{#animate \\"toast\\"}}FREE POINTS!{{/animate}}\\n\\n\\"Well! That was anticlimactic! Moving on!\\"\\n\\n{{section \\"Next Round\\"}}\\n{{/if}}\\n"
    },
    "Sing beautifully": {
        "text": "You belt out an operatic rendition of the show's theme song (which you're making up as you go).\\n\\nThe audience is moved. One of them wakes up specifically to applaud.\\n\\n{{inc \\"score\\" 150}}\\n{{#animate \\"toast\\"}}STANDING OVATION!{{/animate}}\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Sing terribly on purpose": {
        "text": "You screech like a cat in a tumble dryer. On purpose. For art.\\n\\n{{dec \\"patience\\"}}\\n\\nHank: \\"That was... that was really something. Moving on quickly.\\"\\n\\n{{inc \\"score\\" 25}}\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Dance with enthusiasm": {
        "text": "You dance like nobody's watching, except everyone is watching, and also there are cameras.\\n\\n{{inc \\"score\\" 125}}\\nThe cardboard cutout falls over again, but in an approving way.\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Do the robot": {
        "text": "You do the robot so convincingly that a stagehand tries to unplug you.\\n\\n{{inc \\"score\\" 100}}\\n{{#animate \\"toast\\"}}BEEP BOOP{{/animate}}\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "WHIRRRRRR": {
        "text": "You spin around making blender noises. It's deeply unsettling.\\n\\n{{inc \\"score\\" 175}}\\n\\nProfessor Boom's voice echoes from below: \\"MAGNIFICENT!\\"\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Refuse on grounds of dignity": {
        "text": "\\"I'm not doing that.\\"\\n\\n{{dec \\"patience\\"}}\\n\\nHank: \\"Fair enough. Moving on with your dignity intact but your score unchanged.\\"\\n\\n{{section \\"Next Round\\"}}\\n"
    },
    "Next Round": {
        "text": "{{#if (length \\"availableRounds\\") = 0}}\\n{{section \\"Final Round\\"}}\\n{{else}}\\nHank shuffles his cards. \\"Alright, {{player_name}}, ready for round {{round}}?\\"\\n\\nThe wheel looms above you, creaking expectantly.\\n\\n{{section \\"Spin the wheel!\\"}}\\n{{/if}}\\n",
        "attributes": [
            "round+=1"
        ]
    },
    "Final Round": {
        "text": "The studio lights go RED. Dramatic music plays (someone is humming aggressively in the background).\\n\\n{{#animate \\"typewriter\\"}}THE FINAL ROUND{{/animate}}\\n\\n\\"This is it, {{player_name}}! The FINAL ROUND!\\" Hank is vibrating with excitement or possibly caffeine.\\n\\n\\"You have {{score}} points! But this last question is worth... {{#animate \\"toast\\"}}DOUBLE OR NOTHING!{{/animate}}\\"\\n\\nThe audience gasps. The cardboard cutout gasps (the AC kicked in).\\n\\n\\"Here is your FINAL QUESTION:\\"\\n\\n{{#animate \\"typewriter\\"}}**What is the name of your host?**{{/animate}}\\n\\n- {{section \\"Hank Spinneroni\\"}}\\n- {{section \\"Chuck Wheelsworth\\"}}\\n- {{section \\"I genuinely don't remember\\"}}\\n"
    },
    "Hank Spinneroni": {
        "text": "\\"CORRECT! I AM HANK SPINNERONI! Probably!\\"\\n\\n{{inc \\"score\\" score}}\\n{{#animate \\"toast\\"}}SCORE DOUBLED!{{/animate}}\\n\\n{{section \\"Ending\\"}}\\n"
    },
    "Chuck Wheelsworth": {
        "text": "\\"That was my FIRST name! The WRONG first name! But you remembered SOMETHING!\\"\\n\\n{{inc \\"score\\" 50}}\\n\\n\\"Close enough! I'll allow it because I'm tired!\\"\\n\\n{{section \\"Ending\\"}}\\n"
    },
    "I genuinely don't remember": {
        "text": "{{#if patience <= 1}}\\nHank stares at you. A vein throbs in his forehead.\\n\\n\\"It's... it's HANK. My name is HANK. I said it at the START.\\"\\n\\nHe takes a deep breath.\\n\\n\\"You know what? You still win. I just want to go home.\\"\\n\\n{{inc \\"score\\" 25}}\\n{{else}}\\nHank laughs. \\"Honestly? I respect the honesty!\\"\\n\\n{{inc \\"score\\" 75}}\\n\\n\\"The real prize was the confusion we shared along the way!\\"\\n{{/if}}\\n\\n{{section \\"Ending\\"}}\\n"
    },
    "Ending": {
        "text": "{{#if score >= 500}}\\n{{#animate \\"toast\\"}}GRAND CHAMPION!{{/animate}}\\n\\nBalloons fall from the ceiling. Confetti explodes. Professor Boom emerges to set off celebratory fireworks (indoors, against regulations).\\n\\n\\"{{player_name}}, you are our GRAND CHAMPION with {{score}} points!\\"\\n\\nHank hands you an oversized novelty check. It bounces.\\n\\n\\"Congratulations! You've won fame, glory, and whatever prizes we can legally give you after the lawyers review the footage!\\"\\n\\nThe audience carries you out on their shoulders. The cardboard cutout leads the parade.\\n\\n**THE END — GRAND CHAMPION**\\n{{else}}\\n{{#if score >= 200}}\\n{{#animate \\"toast\\"}}WINNER!{{/animate}}\\n\\n\\"{{player_name}}, you finished with {{score}} points! That's... that's actually pretty good!\\"\\n\\nHank shakes your hand. \\"You've won a lovely parting gift!\\"\\n\\nA stagehand hands you a gift basket containing: one (1) cheese, a coupon for 10% off at a store that closed in 2019, and a sincere thank-you note from Hank.\\n\\n\\"Come back anytime! Assuming we're not cancelled by then!\\"\\n\\n**THE END — WINNER**\\n{{else}}\\n\\"{{player_name}}... you finished with {{score}} points.\\"\\n\\nHank looks at his cards. Looks at you. Looks at the audience.\\n\\n\\"You know what? You showed up. You tried. And in the end, isn't that what matters?\\"\\n\\n{{embed \\"catchphrase\\"}}\\n\\n\\"No, actually, points are what matter. But good effort!\\"\\n\\nHe hands you a single balloon. It's already deflating.\\n\\n**THE END — PARTICIPANT**\\n{{/if}}\\n{{/if}}\\n",
        "passages": {
            "catchphrase": {
                "text": "\\"Remember our motto: _'Whose Fortune Is It Anyway? (Legally Speaking, Ours)'_\\"\\n"
            }
        }
    }
};
story.js = [
];"
`;

