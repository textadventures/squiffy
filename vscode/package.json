{
  "name": "squiffy",
  "displayName": "Squiffy",
  "description": "Write Squiffy interactive stories in VS Code, with a live preview and a story map",
  "version": "7.0.0-beta.20",
  "private": true,
  "publisher": "textadventures",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textadventures/squiffy.git",
    "directory": "vscode"
  },
  "homepage": "https://squiffystory.com",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "squiffy",
    "interactive fiction",
    "gamebook"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.squiffy"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "squiffy.json",
        "url": "https://squiffystory.com/schema/squiffy.json"
      }
    ],
    "languages": [
      {
        "id": "squiffy",
        "aliases": [
          "Squiffy"
        ],
        "extensions": [
          ".squiffy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "squiffy",
        "scopeName": "source.squiffy",
        "path": "./dist/squiffy.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "squiffy",
          "title": "Squiffy",
          "icon": "images/activity-bar.svg"
        }
      ]
    },
    "views": {
      "squiffy": [
        {
          "id": "squiffy.sections",
          "name": "Sections",
          "icon": "images/activity-bar.svg",
          "contextualTitle": "Squiffy"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "squiffy.sections",
        "contents": "There's no Squiffy story in this folder yet.\n[New Story](command:squiffy.newStory)\nOr bring in a story from [Twine](https://squiffystory.com/converting-from-twine/) or a gamebook from [Quest](https://squiffystory.com/converting-from-quest/):\n[Convert Twine Story](command:squiffy.convertTwine)\n[Convert Quest Gamebook](command:squiffy.convertQuest)",
        "when": "squiffyNoStory"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with Squiffy",
        "description": "Write an interactive story, play it as you write, and publish it.",
        "steps": [
          {
            "id": "newStory",
            "title": "Make a new story",
            "description": "A story is a folder with a ``squiffy.json`` and its ``.squiffy`` files. Make a new one to start from, or open a folder with a story in it. The Squiffy sidebar lists its sections.\n[New Story](command:squiffy.newStory)\n[Open Folder](command:workbench.action.files.openFolder)\nYou can also bring in a story from [Twine](https://squiffystory.com/converting-from-twine/) or a gamebook from [Quest](https://squiffystory.com/converting-from-quest/).",
            "media": {
              "image": {
                "light": "media/walkthrough/story.png",
                "dark": "media/walkthrough/story-dark.png",
                "hc": "media/walkthrough/story-dark.png",
                "hcLight": "media/walkthrough/story.png"
              },
              "altText": "VS Code, with a story's script in the editor and its sections listed in the Squiffy sidebar"
            },
            "completionEvents": [
              "onContext:squiffyHasStory"
            ]
          },
          {
            "id": "preview",
            "title": "Play it as you write",
            "description": "The preview runs your story beside the script, and updates as you type. Open it with the ▷ button at the top of a ``.squiffy`` file, or **Preview** in the status bar.\n[Show Preview](command:squiffy.showPreview)",
            "media": {
              "image": {
                "light": "media/walkthrough/preview.png",
                "dark": "media/walkthrough/preview-dark.png",
                "hc": "media/walkthrough/preview-dark.png",
                "hcLight": "media/walkthrough/preview.png"
              },
              "altText": "VS Code, with a story's script on the left and the story running in the Squiffy Preview on the right"
            },
            "completionEvents": [
              "onCommand:squiffy.showPreview",
              "onContext:squiffyPreviewOpen"
            ]
          },
          {
            "id": "addSection",
            "title": "Add a section, and link to it",
            "description": "A section starts with its name in double square brackets and a colon, such as ``\\[\\[the garden\\]\\]:``. Link to it from another section with ``\\[\\[the garden\\]\\]``, or ``\\[\\[Go outside\\]\\](the garden)`` for a link with words of its own. The names of your sections come up as you type a link.\n[Add Section](command:squiffy.addSection)\nThe [docs](https://squiffystory.com/basic-concepts/) have more about sections, and passages, which add to the section you're in.",
            "media": {
              "image": {
                "light": "media/walkthrough/link.png",
                "dark": "media/walkthrough/link-dark.png",
                "hc": "media/walkthrough/link-dark.png",
                "hcLight": "media/walkthrough/link.png"
              },
              "altText": "A link being typed in a story's script, with a list of its sections to choose from"
            },
            "completionEvents": [
              "onCommand:squiffy.addSection",
              "onCommand:squiffy.addPassage"
            ]
          },
          {
            "id": "previewFromHere",
            "title": "Start the preview at a section",
            "description": "There's no need to play from the start to try a section: click **Preview from here** above it, or its ▷ in the Squiffy sidebar.\n[Show Sections](command:squiffy.sections.focus)",
            "media": {
              "image": {
                "light": "media/walkthrough/preview-from-here.png",
                "dark": "media/walkthrough/preview-from-here-dark.png",
                "hc": "media/walkthrough/preview-from-here-dark.png",
                "hcLight": "media/walkthrough/preview-from-here.png"
              },
              "altText": "A section in a story's script, with Preview from here above it"
            },
            "completionEvents": [
              "onCommand:squiffy.previewFromHere",
              "onCommand:squiffy.previewSection"
            ]
          },
          {
            "id": "storyMap",
            "title": "See the story map",
            "description": "The story map shows your sections and passages as boxes, and the links between them as arrows, marking any problems. Drag from one box to another to add a link.\n[Show Story Map](command:squiffy.showMap)",
            "media": {
              "image": {
                "light": "media/walkthrough/map.png",
                "dark": "media/walkthrough/map-dark.png",
                "hc": "media/walkthrough/map-dark.png",
                "hcLight": "media/walkthrough/map.png"
              },
              "altText": "VS Code, with a story's script on the left and its story map on the right"
            },
            "completionEvents": [
              "onCommand:squiffy.showMap"
            ]
          },
          {
            "id": "export",
            "title": "Publish it",
            "description": "Share as a Link puts a small story in a web address, to send to anyone, with nothing to upload. Publish to textadventures.co.uk puts it online for free, where players can find it. Export builds it into a web page: a folder or a zip to upload to a website, or a single HTML file to share.\n[Share as a Link](command:squiffy.shareLink)\n[Publish to textadventures.co.uk](command:squiffy.publishOnline)\n[Export](command:squiffy.export)\nThere's more about writing in VS Code in [Squiffy's documentation](https://squiffystory.com/vscode/).",
            "media": {
              "image": {
                "light": "media/walkthrough/export.png",
                "dark": "media/walkthrough/export-dark.png",
                "hc": "media/walkthrough/export-dark.png",
                "hcLight": "media/walkthrough/export.png"
              },
              "altText": "Squiffy: Export's choices: to a folder, as a zip, as a single HTML file, or only story.js"
            },
            "completionEvents": [
              "onCommand:squiffy.export",
              "onCommand:squiffy.shareLink",
              "onCommand:squiffy.publishOnline"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "squiffy.showPreview",
        "title": "Show Preview",
        "category": "Squiffy",
        "icon": "$(play)"
      },
      {
        "command": "squiffy.restartPreview",
        "title": "Restart Preview",
        "category": "Squiffy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "squiffy.previewBack",
        "title": "Back in Preview",
        "category": "Squiffy",
        "icon": "$(arrow-left)"
      },
      {
        "command": "squiffy.showMap",
        "title": "Show Story Map",
        "category": "Squiffy",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "squiffy.searchMap",
        "title": "Search Story Map",
        "category": "Squiffy",
        "icon": "$(search)"
      },
      {
        "command": "squiffy.previewFromHere",
        "title": "Start Preview at This Section",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.previewSection",
        "title": "Preview from Here",
        "category": "Squiffy",
        "icon": "$(play)"
      },
      {
        "command": "squiffy.setMainFile",
        "title": "Use as Main File",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.convertV5",
        "title": "Convert from Squiffy 5",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.export",
        "title": "Export",
        "category": "Squiffy",
        "icon": "$(export)"
      },
      {
        "command": "squiffy.shareLink",
        "title": "Share as a Link",
        "category": "Squiffy",
        "icon": "$(link)"
      },
      {
        "command": "squiffy.publishOnline",
        "title": "Publish to textadventures.co.uk",
        "category": "Squiffy",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "squiffy.playInBrowser",
        "title": "Play in Browser",
        "category": "Squiffy",
        "icon": "$(link-external)"
      },
      {
        "command": "squiffy.newStory",
        "title": "New Story",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.newStoryInFolder",
        "title": "New Squiffy Story Here"
      },
      {
        "command": "squiffy.convertTwine",
        "title": "Convert Twine Story",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.convertQuest",
        "title": "Convert Quest Gamebook",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.addSection",
        "title": "Add Section",
        "category": "Squiffy",
        "icon": "$(add)"
      },
      {
        "command": "squiffy.addPassage",
        "title": "Add Passage",
        "category": "Squiffy"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "squiffy.showPreview",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "navigation@0"
        },
        {
          "command": "squiffy.addSection",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "navigation@1"
        },
        {
          "command": "squiffy.showMap",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "navigation@2"
        },
        {
          "command": "squiffy.previewBack",
          "when": "activeWebviewPanelId == squiffy.preview && squiffyPreviewCanGoBack",
          "group": "navigation@1"
        },
        {
          "command": "squiffy.restartPreview",
          "when": "activeWebviewPanelId == squiffy.preview",
          "group": "navigation@2"
        },
        {
          "command": "squiffy.addPassage",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "1_squiffy@1"
        },
        {
          "command": "squiffy.previewFromHere",
          "when": "editorLangId == squiffy",
          "group": "1_squiffy@2"
        },
        {
          "command": "squiffy.export",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "1_squiffy@3"
        },
        {
          "command": "squiffy.shareLink",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "1_squiffy@3"
        },
        {
          "command": "squiffy.publishOnline",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "1_squiffy@3"
        },
        {
          "command": "squiffy.playInBrowser",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json",
          "group": "1_squiffy@3"
        },
        {
          "command": "squiffy.setMainFile",
          "when": "editorLangId == squiffy",
          "group": "1_squiffy@4"
        }
      ],
      "editor/context": [
        {
          "command": "squiffy.previewFromHere",
          "when": "editorLangId == squiffy",
          "group": "navigation"
        },
        {
          "command": "squiffy.addSection",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "1_squiffy@1"
        },
        {
          "command": "squiffy.addPassage",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "1_squiffy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "squiffy.searchMap",
          "when": "squiffyMapOpen"
        },
        {
          "command": "squiffy.showPreview",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.showMap",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.previewFromHere",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.setMainFile",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.convertV5",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.restartPreview",
          "when": "squiffyPreviewOpen"
        },
        {
          "command": "squiffy.previewBack",
          "when": "squiffyPreviewOpen"
        },
        {
          "command": "squiffy.export",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.shareLink",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.publishOnline",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.playInBrowser",
          "when": "editorLangId == squiffy || resourceFilename == squiffy.json || squiffyHasStory"
        },
        {
          "command": "squiffy.newStoryInFolder",
          "when": "false"
        },
        {
          "command": "squiffy.addSection",
          "when": "editorLangId == squiffy && !editorReadonly"
        },
        {
          "command": "squiffy.addPassage",
          "when": "editorLangId == squiffy && !editorReadonly"
        },
        {
          "command": "squiffy.previewSection",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "squiffy.newStoryInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "squiffy.showPreview",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "navigation@0"
        },
        {
          "command": "squiffy.addSection",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "navigation@1"
        },
        {
          "command": "squiffy.showMap",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "navigation@2"
        },
        {
          "command": "squiffy.export",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "navigation@3"
        },
        {
          "command": "squiffy.shareLink",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "1_squiffy@1"
        },
        {
          "command": "squiffy.publishOnline",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "1_squiffy@2"
        },
        {
          "command": "squiffy.playInBrowser",
          "when": "view == squiffy.sections && !squiffyNoStory",
          "group": "1_squiffy@3"
        }
      ],
      "view/item/context": [
        {
          "command": "squiffy.previewSection",
          "when": "view == squiffy.sections && viewItem =~ /^(section|passage)$/",
          "group": "inline"
        },
        {
          "command": "squiffy.previewSection",
          "when": "view == squiffy.sections && viewItem =~ /^(section|passage)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "squiffy.searchMap",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'squiffy.map'"
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && svelte-check --tsconfig src/map/tsconfig.json --fail-on-warnings && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest --run",
    "dev": "vitest",
    "package": "npm run build && cp ../LICENSE LICENSE && vsce package --no-dependencies",
    "open-web": "vscode-test-web --extensionDevelopmentPath=. ../examples"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@textadventures/graph-map": "^7.0.0-beta.20",
    "@textadventures/squiffy-app": "^7.0.0-beta.20",
    "@textadventures/squiffy-packager": "^7.0.0-beta.20",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.146.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "squiffy-compiler": "^7.0.0-beta.20",
    "squiffy-runtime": "^7.0.0-beta.20",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vscode-languageclient": "^11.0.1",
    "vscode-languageserver": "^11.0.1",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
