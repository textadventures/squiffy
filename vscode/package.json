{
  "name": "squiffy",
  "displayName": "Squiffy",
  "description": "Write Squiffy interactive stories in VS Code, with a live preview",
  "version": "7.0.0-beta.14",
  "private": true,
  "publisher": "textadventures",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textadventures/squiffy.git",
    "directory": "vscode"
  },
  "homepage": "https://squiffystory.com",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "squiffy",
    "interactive fiction",
    "gamebook"
  ],
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.squiffy"
  ],
  "contributes": {
    "languages": [
      {
        "id": "squiffy",
        "aliases": [
          "Squiffy"
        ],
        "extensions": [
          ".squiffy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "squiffy",
        "scopeName": "source.squiffy",
        "path": "./dist/squiffy.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "squiffy",
        "path": "./snippets/squiffy.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "squiffy.showPreview",
        "title": "Show Preview",
        "category": "Squiffy",
        "icon": "$(open-preview)"
      },
      {
        "command": "squiffy.restartPreview",
        "title": "Restart Preview",
        "category": "Squiffy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "squiffy.previewBack",
        "title": "Back in Preview",
        "category": "Squiffy",
        "icon": "$(arrow-left)"
      },
      {
        "command": "squiffy.previewFromHere",
        "title": "Start Preview at This Section",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.setMainFile",
        "title": "Use as Main File",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.convertV5",
        "title": "Convert from Squiffy 5",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.export",
        "title": "Export",
        "category": "Squiffy",
        "icon": "$(export)"
      },
      {
        "command": "squiffy.newStory",
        "title": "New Story",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.newStoryInFolder",
        "title": "New Squiffy Story Here"
      },
      {
        "command": "squiffy.addSection",
        "title": "Add Section",
        "category": "Squiffy"
      },
      {
        "command": "squiffy.addPassage",
        "title": "Add Passage",
        "category": "Squiffy"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "squiffy.showPreview",
          "when": "editorLangId == squiffy",
          "group": "navigation"
        },
        {
          "command": "squiffy.previewBack",
          "when": "activeWebviewPanelId == squiffy.preview && squiffyPreviewCanGoBack",
          "group": "navigation@1"
        },
        {
          "command": "squiffy.restartPreview",
          "when": "activeWebviewPanelId == squiffy.preview",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "squiffy.previewFromHere",
          "when": "editorLangId == squiffy",
          "group": "navigation"
        },
        {
          "command": "squiffy.addSection",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "1_squiffy@1"
        },
        {
          "command": "squiffy.addPassage",
          "when": "editorLangId == squiffy && !editorReadonly",
          "group": "1_squiffy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "squiffy.showPreview",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.previewFromHere",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.setMainFile",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.convertV5",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.restartPreview",
          "when": "squiffyPreviewOpen"
        },
        {
          "command": "squiffy.previewBack",
          "when": "squiffyPreviewOpen"
        },
        {
          "command": "squiffy.export",
          "when": "editorLangId == squiffy"
        },
        {
          "command": "squiffy.newStoryInFolder",
          "when": "false"
        },
        {
          "command": "squiffy.addSection",
          "when": "editorLangId == squiffy && !editorReadonly"
        },
        {
          "command": "squiffy.addPassage",
          "when": "editorLangId == squiffy && !editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "squiffy.newStoryInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest --run",
    "dev": "vitest",
    "package": "npm run build && cp ../LICENSE LICENSE && vsce package --no-dependencies",
    "open-web": "vscode-test-web --extensionDevelopmentPath=. ../examples"
  },
  "devDependencies": {
    "@textadventures/squiffy-packager": "^7.0.0-beta.14",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.91.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "squiffy-compiler": "^7.0.0-beta.14",
    "squiffy-runtime": "^7.0.0-beta.14",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vscode-languageclient": "^11.0.1",
    "vscode-languageserver": "^11.0.1",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
