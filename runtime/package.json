{
  "name": "squiffy-runtime",
  "version": "7.0.0-beta.18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textadventures/squiffy.git",
    "directory": "runtime"
  },
  "type": "module",
  "main": "dist/squiffy.runtime.js",
  "types": "dist/squiffy.runtime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/squiffy.runtime.d.ts",
      "default": "./dist/squiffy.runtime.js"
    },
    "./squiffy.runtime.css": "./dist/squiffy.runtime.css",
    "./dist/squiffy.runtime.global.js": "./dist/squiffy.runtime.global.js",
    "./dist/squiffy.runtime.css": "./dist/squiffy.runtime.css",
    "./squiffy.page.css": "./dist/squiffy.page.css",
    "./dist/squiffy.page.css": "./dist/squiffy.page.css",
    "./preview-host": {
      "types": "./dist/preview-host.d.ts",
      "default": "./dist/preview-host.js"
    },
    "./preview-html": {
      "types": "./dist/preview-html.d.ts",
      "default": "./dist/preview-html.js"
    },
    "./squiffy.preview.html": "./dist/squiffy.preview.html"
  },
  "scripts": {
    "dev": "vitest",
    "test": "vitest --run",
    "build": "vite build && vite build -c vite.preview.config.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "author": "Alex Warren",
  "contributors": [
    "CrisisSDK",
    "mrangel",
    "Luis Felipe Morales"
  ],
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "css.escape": "^1.5.1",
    "esbuild": "^0.28.2",
    "global-jsdom": "^31.0.0",
    "jsdom": "^31.0.1",
    "squiffy-compiler": "^7.0.0-beta.18",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "handlebars": "^4.7.10",
    "marked": "^18.2.0"
  },
  "publishConfig": {
    "timeout": 60000
  }
}
