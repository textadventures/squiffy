{
  "name": "@textadventures/project-fs",
  "version": "7.0.0-beta.6",
  "private": true,
  "description": "A file system layer over a rooted project tree, with in-memory, File System Access, OPFS, Node and Electron adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textadventures/squiffy.git",
    "directory": "project-fs"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./electron-main": {
      "types": "./dist/electron/main.d.ts",
      "default": "./dist/electron/main.js"
    },
    "./electron-preload": {
      "types": "./dist/electron/preload.d.ts",
      "default": "./dist/electron/preload.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run",
    "dev": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
